{
  "id": "zogograph-key-custody",
  "version": "0.1.1",
  "name": "HostScope remote key custody",
  "publisher": "HostScope",
  "summary": "Optional client for the HostScope key-custody service using signed enrolled-client authentication and registered-envelope authorization.",
  "license": "Proprietary preview",
  "capabilities": [
    "key_provider",
    "network_client",
    "package_private_database"
  ],
  "runtime": {
    "kind": "zogograph-isolated-php-package",
    "entrypoint": "src/KeyCustodyProvider.php",
    "provider_class": "HostScope\\Plugin\\KeyCustody\\KeyCustodyProvider",
    "operations": [
      "capability",
      "custody_endpoint_probe",
      "custody_enrollment_check",
      "custody_store_envelope",
      "custody_unwrap_artifact"
    ],
    "minimum_api": "1.0"
  },
  "settings_schema": "settings.schema.json",
