    "zh": "locales/zh.json"
  },
  "data": {
    "directory": "data",
    "migration_namespace": "zogograph_key_custody"
  },
  "compatibility": {
    "min_php": "8.1.0",
    "requires_extensions": ["curl", "openssl", "sodium"],
    "requires_runtime_capability": "isolated_package_runtime"
  },
